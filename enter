#!/usr/bin/env bash
#
# One-shot onboarding: check for everything Particle Garden needs on this Mac,
# ask before installing anything missing, then build and run it (just be).
#
# Author: Nick Krause
# Created: 2026-08-01
#
# Phases run as: clt brew just nim bun repo run. Function names follow
# phase_<id>_<verb>, called through phase_dispatch — shellcheck cannot see
# those calls, hence the file-wide disable below.
# shellcheck disable=SC2329
#
# Traps, logging, prompts, the spinner, the ledger, the lock, and is_clone
# live in scripts/lib/ and are shared with ./leave, sourced from within the
# clone — so this script runs only from inside one. Project dependencies are
# `just be`'s job, not this script's.

if [ -z "${BASH_VERSION-}" ]; then exec /bin/bash "$0" "$@"; fi

if [[ ${DEBUG-} =~ ^(1|yes|true)$ ]]; then set -o xtrace; fi

# Strict mode only when executed, never when sourced (the BATS unit suite
# sources this file to reach individual functions).
if ! (return 0 2>/dev/null); then
  set -o errexit
  set -o nounset
  set -o pipefail
  set -o errtrace
fi

# The bootstrap README documents. It clones, then runs this script inside the
# clone; this script never fetches code itself, so it points here when asked
# to work outside one.
GARDEN_SH_URL='https://raw.githubusercontent.com/synapseradio/particle-garden/HEAD/tools/garden.sh'
PHASE_ORDER='clt brew just nim bun repo'
TRAP_ERR_REPORT='report_phase_failure'
CURRENT_PHASE=''
CLONE_DIR=''
OWNER_EMAIL=''
ARCH=''
PLAN=()

#######################################
# What script_trap_err says when a phase blows up. Silent before the first
# phase starts — there is nothing to name yet.
#######################################
function report_phase_failure() {
  if [ -z "${CURRENT_PHASE-}" ]; then
    return 0
  fi
  log 'ERROR' "Something went wrong during the $(phase_title "${CURRENT_PHASE}") step." "${C_ERROR-}"
  log 'INFO' 'Nothing after that step was touched. Fix the issue (network down?) and run ./enter again — finished steps are skipped.'
}

# ===========================================================================
# Install helpers
# ===========================================================================

#######################################
# True when brew can install without sudo, i.e. its bin dir is writable.
# Output is only streamed in that case — otherwise brew may prompt.
#######################################
function brew_prefix_writable() {
  local prefix
  prefix="$(brew --prefix 2>/dev/null)" || return 1
  [ -w "${prefix}/bin" ]
}

#######################################
# Installs one Homebrew formula, through run_step only when no sudo prompt can
# appear. bun falls back to the oven-sh tap. `hash -r` afterwards — bash
# caches PATH lookups and would keep resolving the old or absent binary.
#######################################
function brew_install_formula() {
  local formula="$1"

  if [ -n "${dry_run-}" ]; then
    log 'DRY-RUN' "brew install ${formula}" "${C_HINT-}"
    return 0
  fi

  local st=0
  if brew_prefix_writable; then
    if ! run_step "Installing ${formula} with Homebrew…" brew install "${formula}"; then
      st=1
    fi
  else
    log 'INFO' "Installing ${formula} — Homebrew may ask for your macOS password." "${C_INFO-}"
    if ! brew install "${formula}"; then
      st=1
    fi
  fi

  if [ "${st}" -ne 0 ] && [ "${formula}" = 'bun' ]; then
    log 'INFO' 'Plain bun formula failed — trying the oven-sh tap.' "${C_INFO-}"
    if run_step 'Installing bun from the oven-sh tap…' brew install oven-sh/bun/bun; then
      st=0
    fi
  fi

  if [ "${st}" -ne 0 ]; then
    log 'ERROR' "brew install ${formula} failed." "${C_ERROR-}"
    return 1
  fi

  hash -r
}

#######################################
# True when the installed nim's major version satisfies particle_garden.nimble
# (>= 2.0.0 and < 3.0.0). Parses with awk, never `head -1` — head can exit
# 141 (SIGPIPE) under pipefail.
#######################################
function nim_version_ok() {
  local ver major
  ver="$(nim --version 2>/dev/null | awk 'NR == 1 { print $4 }')"
  case "${ver}" in
    [0-9]*.*) ;;
    *) return 1 ;;
  esac
  major="${ver%%.*}"
  case "${major}" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "${major}" -ge 2 ] && [ "${major}" -lt 3 ]
}

function nim_found_version() {
  nim --version 2>/dev/null | awk 'NR == 1 { print $4 }'
}

# ===========================================================================
# Phase: clt (Xcode Command Line Tools)
# ===========================================================================

function phase_clt_detect() {
  xcode-select -p >/dev/null 2>&1 && xcrun --find clang >/dev/null 2>&1
}

function phase_clt_prompt() {
  printf "Install Apple's Xcode Command Line Tools? (compiler and git — Apple opens its own install window, a few GB)"
}

function phase_clt_install() {
  # Exits 1 when already requested or installed — the poll decides the truth.
  maybe_run xcode-select --install 2>/dev/null || true

  if [ -n "${dry_run-}" ]; then
    return 0
  fi

  log 'INFO' 'Apple opened an install window — it may be hiding behind other windows. Click Install there.' "${C_INFO-}"
  spinner_start 'Waiting for the Command Line Tools installer to finish…'
  local waited=0
  until phase_clt_detect; do
    sleep 5
    waited=$((waited + 5))
    if [ $((waited % 60)) -eq 0 ]; then
      spinner_message "Still waiting on the Command Line Tools installer (about $((waited / 60)) min so far — big download, no rush)…"
    fi
  done
  spinner_stop
}

function phase_clt_verify() {
  phase_clt_detect || return 1
  clang --version >/dev/null 2>&1 || return 1
  command -v git >/dev/null 2>&1 || return 1
  hash -r
}

function phase_clt_record() {
  ledger_append installed tool clt "$(xcode-select -p 2>/dev/null || true)"
  if [ -z "${dry_run-}" ]; then
    rm -f "$(state_dir)/clt-installed-by-garden"
  fi
}

#######################################
# Detect-hit path. garden.sh may have installed the CLT before enter existed
# locally; its marker turns `preexisting` into `installed` so ./leave knows.
# The marker is consumed exactly once.
#######################################
function phase_clt_adopt() {
  local marker
  marker="$(state_dir)/clt-installed-by-garden"
  if [ -f "${marker}" ]; then
    ledger_append installed tool clt 'installed by the garden.sh bootstrap'
    if [ -z "${dry_run-}" ]; then
      rm -f "${marker}"
    fi
  else
    record_preexisting tool clt "$(xcode-select -p 2>/dev/null || true)"
  fi
}

# ===========================================================================
# Phase: brew (Homebrew)
# ===========================================================================

#######################################
# PATH hit, or a known prefix hit — in which case brew's shellenv is evaluated
# in-process immediately so the postcondition holds for the rest of the run
# (monotone progress: never "restart your terminal"). ENTER_BREW_PATHS
# overrides the probe list (test seam).
#######################################
function phase_brew_detect() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi

  local candidates="${ENTER_BREW_PATHS:-/opt/homebrew/bin/brew:/usr/local/bin/brew}"
  local oldifs="${IFS}"
  local c
  IFS=':'
  for c in ${candidates}; do
    if [ -x "${c}" ]; then
      IFS="${oldifs}"
      eval "$("${c}" shellenv)"
      hash -r
      return 0
    fi
  done
  IFS="${oldifs}"
  return 1
}

function phase_brew_prompt() {
  printf 'Install Homebrew? (the package manager the rest of the tools come from — its installer will explain itself and may ask for your macOS password)'
}

#######################################
# Runs the official installer interactively, never NONINTERACTIVE=1 — under
# NONINTERACTIVE it switches to `sudo -n`, which dies without a cached sudo
# timestamp: the exact state of a fresh machine. Consent was already gathered;
# stdin is the terminal (the bash -c bootstrap form preserves it); the spinner
# stays off because the installer prints, waits for RETURN, and sudo-prompts.
#######################################
function phase_brew_install() {
  if [ -n "${dry_run-}" ]; then
    # shellcheck disable=SC2016
    log 'DRY-RUN' '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"' "${C_HINT-}"
    return 0
  fi

  log 'INFO' "Handing over to Homebrew's installer — it explains each step." "${C_INFO-}"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  local brew_bin
  if command -v brew >/dev/null 2>&1; then
    # A Rosetta shell reports x86_64 while brew lives in /opt/homebrew —
    # trust PATH over uname when brew already resolves.
    brew_bin="$(command -v brew)"
  elif [ "${ARCH}" = 'arm64' ]; then
    brew_bin='/opt/homebrew/bin/brew'
  else
    brew_bin='/usr/local/bin/brew'
  fi
  eval "$("${brew_bin}" shellenv)"
  hash -r
}

function phase_brew_verify() {
  brew --version >/dev/null 2>&1 || return 1
  hash -r
}

function phase_brew_record() {
  ledger_append installed tool brew "$(command -v brew || true)"
}

function phase_brew_adopt() {
  record_preexisting tool brew "$(command -v brew || true)"
}

#######################################
# Offers to persist brew's shellenv in ~/.zprofile (marker-fenced block, once).
# When the file is a symlink — commonly into a dotfiles repo — the prompt
# names the real target and defaults to no.
#######################################
function persist_shellenv_offer() {
  local zprofile
  zprofile="$(zprofile_path)"

  if [ -f "${zprofile}" ] && grep -qF "${ZPROFILE_MARK_START}" "${zprofile}"; then
    return 0
  fi

  local brew_bin
  brew_bin="$(command -v brew 2>/dev/null || true)"
  if [ -z "${brew_bin}" ]; then
    return 0
  fi

  local prompt='Add Homebrew to your shell startup file (~/.zprofile) so brew works in new terminal windows?'
  local default='y'
  if [ -L "${zprofile}" ]; then
    prompt="Your ~/.zprofile is a symlink to $(readlink "${zprofile}") — append the Homebrew setup block there anyway?"
    default='n'
  fi

  if ! confirm "${prompt}" "${default}"; then
    ledger_append declined shellenv zprofile "${zprofile}"
    return 0
  fi

  if [ -n "${dry_run-}" ]; then
    log 'DRY-RUN' "append the Homebrew shellenv block to ${zprofile}" "${C_HINT-}"
    return 0
  fi

  {
    printf '%s\n' "${ZPROFILE_MARK_START}"
    # shellcheck disable=SC2016
    printf 'eval "$(%s shellenv)"\n' "${brew_bin}"
    printf '%s\n' "${ZPROFILE_MARK_END}"
  } >> "${zprofile}"
  ledger_append installed shellenv zprofile "${zprofile}"
}

